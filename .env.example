# Copy to .env.local (local) and add the same variables in Vercel -> Project Settings -> Environment Variables.
# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Recommended (server only, never expose): lets registration create confirmed accounts,
# so "Confirm email" can stay on. Without it, turn "Confirm email" OFF in Supabase Auth settings.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: internal email domain used to map phone numbers to Supabase Auth accounts.
# NEXT_PUBLIC_AUTH_EMAIL_DOMAIN=phone.pulsegym.app

# Leave the Supabase variables empty to run in demo mode (data stored in the browser).
